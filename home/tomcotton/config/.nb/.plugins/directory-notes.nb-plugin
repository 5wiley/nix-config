#!/usr/bin/env bash
###############################################################################
# directory-notes.nb-plugin
#
# Create or edit a note for the current directory.
#
# A plugin for `nb`.
#   https://github.com/xwmx/nb
###############################################################################

# Add the new subcommand name with `_subcommands add <name>`.
_subcommands add "dir"

# Define help and usage text with `_subcommands describe <subcommand> <usage>`.
_subcommands describe "dir" <<HEREDOC
Usage:
  nb dir [<options>] [<content>]

Options:
  -d, --dir            Automatically add the top level directory name as a tag after the date.
  -t, --tags <tags>    Add custom tags after the date (comma-separated list).

Description:
  If content is provided, prepend a timestamped log entry to the directory note.
  If no content is provided, open the directory note in the editor.
HEREDOC

# Define the subcommand as a function, named with a leading underscore.
_dir() {
  local abs_path="$PWD"
  local dir parent_dir parent_dir_path note_name

  if [ "$abs_path" = "/" ]; then
    dir="root"
    parent_dir="root"
  else
    dir=$(basename "$abs_path")
    parent_dir_path=$(dirname "$abs_path")
    if [ "$parent_dir_path" = "/" ]; then
      parent_dir="root"
    else
      parent_dir=$(basename "$parent_dir_path")
    fi
  fi

  local ext="${NB_DEFAULT_EXTENSION:-md}"
  note_name="Directories/[${parent_dir}] ${dir}.${ext}"

  # Search for notes tagged with the path
  local note_path=""
  find_note_path() {
    local paths
    paths=$(nb search -t "$abs_path" --path 2>/dev/null || true)
    if [ -n "$paths" ]; then
      while IFS= read -r p; do
        [ -z "$p" ] && continue
        if [ -f "$p" ] && grep -q -F "#${abs_path}" "$p"; then
          note_path="$p"
          return 0
        fi
      done <<< "$paths"
    fi
    return 1
  }

  find_note_path || true

  # Ensure the note exists in the current notebook.
  # If it doesn't exist, create it.
  if [ -z "$note_path" ]; then
    echo "" | nb add "${note_name}" --tags "${abs_path}" >/dev/null
    find_note_path || true
    if [ -z "$note_path" ]; then
      note_path="${NB_NOTEBOOK_PATH}/${note_name}"
    fi
  fi

  local add_dir_tag=false
  local custom_tags_raw=""
  local content_args=()
  
  local i=0
  while [ $i -lt "${#_ARGUMENTS[@]}" ]; do
    local arg="${_ARGUMENTS[$i]}"
    case "$arg" in
      -d|--dir)
        add_dir_tag=true
        ;;
      -t|--tags)
        i=$((i + 1))
        custom_tags_raw="${_ARGUMENTS[$i]:-}"
        ;;
      *)
        content_args+=("$arg")
        ;;
    esac
    i=$((i + 1))
  done

  if [ "${#content_args[@]}" -gt 0 ]; then
    # We received content arguments. Prepend them to the log note.
    # Join the arguments by space to support both quoted and unquoted inputs.
    local content
    local old_ifs="$IFS"
    IFS=" "
    content="${content_args[*]}"
    IFS="$old_ifs"

    local timestamp
    timestamp=$(date "+%Y-%m-%d %H:%M:%S")

    local human_date
    human_date=$(date "+%B, %A %e" | tr -s ' ')

    local formatted_tags=""
    if [ -n "$custom_tags_raw" ]; then
      local old_ifs_tags="$IFS"
      IFS=","
      for tag in $custom_tags_raw; do
        tag=$(echo "$tag" | xargs)
        if [ -n "$tag" ]; then
          if [[ ! "$tag" =~ ^# ]]; then
            tag="#${tag}"
          fi
          formatted_tags="${formatted_tags} ${tag}"
        fi
      done
      IFS="$old_ifs_tags"
    fi

    local dir_tag=""
    if [ "$add_dir_tag" = "true" ]; then
      local dir_name
      dir_name=$(basename "$PWD")
      dir_tag=" #${dir_name}"
    fi

    local combined_tags="${formatted_tags}${dir_tag}"

    # Format the log entry: [date] Human Date: #tags \n content
    # Prepend to the file using nb edit's --prepend flag
    printf "[%s] %s:%s\n%s\n\n" "$timestamp" "$human_date" "$combined_tags" "$content" | nb edit "$note_path" --prepend >/dev/null
  else
    # No content arguments. Open the log note in the editor.
    nb edit "$note_path"
  fi
}
