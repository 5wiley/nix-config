#!/usr/bin/env bash
# Convenience wrapper for infrastructure health report
# Usage: ./scripts/infra-report [time-window]
# Examples:
#   ./scripts/infra-report          # Last 24 hours
#   ./scripts/infra-report 12h      # Last 12 hours
#   ./scripts/infra-report 7d       # Last 7 days

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR/.."

TIME_WINDOW="${1:-24h}"

echo "=== Infrastructure Health Report — Last $TIME_WINDOW ==="
echo "Generated: $(date -Iseconds)"
echo

# Run infra-report.sh and pipe to formatter
./scripts/infra-report.sh --since="$TIME_WINDOW" | ./scripts/format-infra-report.sh